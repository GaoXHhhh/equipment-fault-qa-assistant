# ===== DeepSeek =====
# 项目读取顺序：系统环境变量 > Windows 注册表 > 本文件
# 变量名大小写不敏感：DEEPSEEK_API_KEY 或 deepseek_api_key 都可以
# 注意：本文件只能写 key=value，不能写 Python 代码
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.2

# ===== 向量检索 =====
# 默认 local：本地字符语义向量 + BM25 混合检索，无需 Key、无需联网
# 也可配 openai_compatible / dashscope，改用外部 Embedding 接口
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-v4

# ===== 检索与切片参数（一般不用改）=====
CHUNK_SIZE=520
CHUNK_OVERLAP=80
TOP_K=5
MAX_UPLOAD_MB=30
